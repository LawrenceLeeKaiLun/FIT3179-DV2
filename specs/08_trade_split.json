{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "direction",
      "type": "nominal",
      "sort": [
        "Import",
        "Export"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelPadding": 8
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "trade_value_usd_1000",
      "type": "quantitative",
      "title": "Total trade value (US$ thousand)",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "direction",
      "type": "nominal",
      "scale": {
        "domain": [
          "Import",
          "Export"
        ],
        "range": [
          "#8B5E3C",
          "#CDA77D"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "direction",
        "type": "nominal",
        "title": "Trade direction"
      },
      {
        "aggregate": "sum",
        "field": "trade_value_usd_1000",
        "type": "quantitative",
        "title": "Total value (US$ thousand)",
        "format": ",.2f"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Number of partner records"
      }
    ]
  }
}