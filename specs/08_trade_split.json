{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "width": "container",
  "height": 240,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "direction",
      "type": "nominal",
      "title": null
    },
    "y": {
      "aggregate": "sum",
      "field": "trade_value_usd_1000",
      "type": "quantitative",
      "title": "Listed partners (US$ thousand)"
    },
    "color": {
      "field": "direction",
      "type": "nominal",
      "scale": {
        "domain": [
          "Import",
          "Export"
        ],
        "range": [
          "#8a5938",
          "#2e756f"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "direction"
      },
      {
        "aggregate": "sum",
        "field": "trade_value_usd_1000",
        "format": ",.2f"
      }
    ]
  }
}
