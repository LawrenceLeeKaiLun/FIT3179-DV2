{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "#ffffff",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "direction",
      "type": "nominal",
      "sort": [
        "Import",
        "Export"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelPadding": 10,
        "ticks": false
      }
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": [
        "Vietnam",
        "Indonesia",
        "Brazil",
        "Colombia",
        "Singapore",
        "India",
        "China",
        "Australia",
        "South Korea",
        "Thailand"
      ],
      "title": null
    },
    "color": {
      "field": "trade_value_usd_1000",
      "type": "quantitative",
      "scale": {
        "type": "threshold",
        "domain": [
          1000,
          5000,
          20000,
          80000
        ],
        "range": [
          "#f3e9dc",
          "#e1c5a1",
          "#c99768",
          "#a76546",
          "#783d35"
        ]
      },
      "title": "Trade value (US$ thousand)",
      "legend": {
        "title": "Trade value (US$ thousand)",
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 400
      }
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Partner"
      },
      {
        "field": "direction",
        "type": "nominal",
        "title": "Trade direction"
      },
      {
        "field": "trade_value_usd_1000",
        "type": "quantitative",
        "title": "Trade value (US$ thousand)",
        "format": ",.2f"
      }
    ]
  },
  "transform": [
    {
      "filter": {
        "field": "country",
        "oneOf": [
          "Vietnam",
          "Indonesia",
          "Brazil",
          "Colombia",
          "Singapore",
          "India",
          "China",
          "Thailand",
          "Australia",
          "South Korea"
        ]
      }
    }
  ]
}