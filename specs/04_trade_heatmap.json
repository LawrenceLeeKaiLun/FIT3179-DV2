{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "width": "container",
  "height": 290,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "direction",
      "type": "nominal",
      "title": null
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": "-color",
      "title": null
    },
    "color": {
      "field": "trade_value_usd_1000",
      "type": "quantitative",
      "scale": {
        "scheme": "browns"
      },
      "title": "US$ thousand"
    },
    "tooltip": [
      {
        "field": "country"
      },
      {
        "field": "direction"
      },
      {
        "field": "trade_value_usd_1000",
        "format": ",.2f"
      }
    ]
  },
  "transform": [
    {
      "filter": {
        "field": "country",
        "oneOf": [
          "Vietnam",
          "Indonesia",
          "Brazil",
          "Colombia",
          "Singapore",
          "India",
          "China",
          "Thailand",
          "Australia",
          "South Korea"
        ]
      }
    }
  ]
}
