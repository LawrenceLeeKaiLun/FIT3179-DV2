{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "transform": [
    {
      "filter": "datum.direction === 'Import'"
    },
    {
      "filter": {
        "field": "country",
        "oneOf": [
          "Vietnam",
          "Indonesia",
          "Brazil",
          "Colombia",
          "Singapore"
        ]
      }
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "trade_value_usd_1000",
          "as": "top_five_total"
        }
      ]
    },
    {
      "calculate": "datum.trade_value_usd_1000 / datum.top_five_total",
      "as": "share"
    }
  ],
  "params": [
    {
      "name": "choose_country",
      "select": {
        "type": "point",
        "fields": [
          "country"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "arc",
    "innerRadius": 85,
    "outerRadius": 140,
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "theta": {
      "field": "trade_value_usd_1000",
      "type": "quantitative",
      "stack": true
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {
        "domain": [
          "Vietnam",
          "Indonesia",
          "Brazil",
          "Colombia",
          "Singapore"
        ],
        "range": [
          "#a95e45",
          "#d69a4b",
          "#397c79",
          "#7667a0",
          "#D9799A"
        ]
      },
      "legend": {
        "title": "Import partner",
        "orient": "bottom",
        "columns": 3,
        "labelFontSize": 12,
        "symbolSize": 150
      }
    },
    "opacity": {
      "condition": {
        "param": "choose_country",
        "value": 1
      },
      "value": 0.25
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Import partner"
      },
      {
        "field": "trade_value_usd_1000",
        "type": "quantitative",
        "title": "Import value (US$ thousand)",
        "format": ",.2f"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of top five",
        "format": ".1%"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  }
}