{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "projection": {
    "type": "equalEarth"
  },
  "width": "container",
  "height": 340,
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5dfd4",
        "stroke": "#fff",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "url": "data/map_imports_2024.csv"
            },
            "key": "id",
            "fields": [
              "value",
              "country"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fff",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "scheme": "browns"
          },
          "title": "US$ thousand"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Partner"
          },
          {
            "field": "value",
            "title": "US$ thousand",
            "format": ",.2f"
          }
        ]
      }
    }
  ]
}
