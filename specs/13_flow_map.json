{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "labelLimit": 140
    }
  },
  "projection": {
    "type": "equalEarth"
  },
  "width": "container",
  "height": 330,
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e5dfd4",
        "stroke": "#fff",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/import_flow_curved_2024.csv"
      },
      "transform": [
        {
          "filter": {
            "field": "country",
            "oneOf": [
              "India",
              "Papua New Guinea",
              "Guatemala",
              "Switzerland",
              "Ethiopia"
            ]
          }
        }
      ],
      "mark": {
        "type": "line",
        "color": "#b7c1bb",
        "opacity": 0.48,
        "strokeWidth": 1.0
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "step",
          "type": "ordinal"
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Import partner"
          },
          {
            "field": "trade_value_usd_1000",
            "type": "quantitative",
            "title": "Import value (US$ thousand)",
            "format": ",.2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/import_flow_curved_2024.csv"
      },
      "transform": [
        {
          "filter": {
            "field": "country",
            "oneOf": [
              "Vietnam",
              "Indonesia",
              "Brazil",
              "Colombia",
              "Singapore"
            ]
          }
        }
      ],
      "mark": {
        "type": "line",
        "opacity": 0.83,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "step",
          "type": "ordinal"
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "domain": [
              "Vietnam",
              "Indonesia",
              "Brazil",
              "Colombia",
              "Singapore"
            ],
            "range": [
              "#a64b31",
              "#d38a36",
              "#2c7774",
              "#6e6097",
              "#498e57"
            ]
          },
          "legend": {
            "title": "Top five import partners",
            "orient": "bottom",
            "columns": 5,
            "labelFontSize": 10,
            "symbolType": "stroke"
          }
        },
        "strokeWidth": {
          "field": "trade_value_usd_1000",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              140000
            ],
            "range": [
              1.3,
              3.5
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Import partner"
          },
          {
            "field": "trade_value_usd_1000",
            "type": "quantitative",
            "title": "Import value (US$ thousand)",
            "format": ",.2f"
          }
        ]
      }
    }
  ]
}