{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "mark": {
    "type": "circle",
    "color": "#8a5938",
    "opacity": 0.8,
    "size": 110
  },
  "encoding": {
    "x": {
      "field": "quantity_kg",
      "type": "quantitative",
      "title": "Import quantity (kg)"
    },
    "y": {
      "field": "trade_value_usd_1000",
      "type": "quantitative",
      "title": "Import value (US$ thousand)"
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "quantity_kg",
        "type": "quantitative",
        "title": "Quantity (kg)",
        "format": ","
      },
      {
        "field": "trade_value_usd_1000",
        "type": "quantitative",
        "title": "Value (US$ thousand)",
        "format": ",.2f"
      }
    ]
  },
  "transform": [
    {
      "filter": "datum.direction === 'Import'"
    }
  ]
}