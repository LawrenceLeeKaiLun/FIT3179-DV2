{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": "container",
  "height": 230,
  "data": {
    "url": "data/malaysia_green_coffee_production_2020_2024.csv"
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 85
    },
    "color": "#8a5938",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "production_tonnes",
      "type": "quantitative",
      "title": "Production (tonnes)",
      "scale": {
        "zero": true
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "production_tonnes",
        "title": "Production (tonnes)",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    }
  }
}