{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "bin": {
        "maxbins": 12
      },
      "field": "trade_value_usd_1000",
      "type": "quantitative",
      "title": "Import partner value (US$ thousand)"
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of listed partners"
    },
    "tooltip": [
      {
        "aggregate": "count",
        "type": "quantitative"
      }
    ]
  },
  "transform": [
    {
      "filter": "datum.direction === 'Import'"
    }
  ]
}
