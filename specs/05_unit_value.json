{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#5b554d",
      "titleColor": "#5b554d",
      "gridColor": "#eae3d9",
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 11
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#5b554d",
      "titleColor": "#5b554d"
    }
  },
  "width": "container",
  "height": 480,
  "data": {
    "url": "data/malaysia_coffee_trade_2024.csv"
  },
  "mark": {
    "type": "tick",
    "thickness": 3,
    "size": 30,
    "color": "#2e756f"
  },
  "encoding": {
    "x": {
      "field": "unit_value_usd_per_kg",
      "type": "quantitative",
      "title": "Import value per kg (US$)"
    },
    "y": {
      "field": "country",
      "type": "nominal",
      "sort": {
        "field": "unit_value_usd_per_kg",
        "op": "max",
        "order": "descending"
      },
      "title": null
    },
    "tooltip": [
      {
        "field": "country",
        "title": "Country"
      },
      {
        "field": "unit_value_usd_per_kg",
        "title": "Value per kg (US$)",
        "format": ".2f"
      },
      {
        "field": "quantity_kg",
        "title": "Quantity (kg)",
        "format": ","
      },
      {
        "field": "trade_value_usd_1000",
        "title": "Import value (US$ thousand)",
        "format": ",.2f"
      }
    ]
  },
  "transform": [
    {
      "filter": "datum.direction === 'Import'"
    },
    {
      "filter": "datum.trade_value_usd_1000 >= 1000"
    }
  ]
}